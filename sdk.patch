diff --git a/libs/display/EpdiyLcd/src/epdiy/src/output_lcd/paperdiy_feed_start.h b/libs/display/EpdiyLcd/src/epdiy/src/output_lcd/paperdiy_feed_start.h
new file mode 100644
--- /dev/null
+++ b/libs/display/EpdiyLcd/src/epdiy/src/output_lcd/paperdiy_feed_start.h
@@ -0,0 +1,69 @@
+#pragma once
+
+// Included after retrieve_line_isr. All helpers run in feeder/task context.
+// State: 0 waiting, 1 scan claimed, 2 aborted before any scan.
+static inline int IRAM_ATTR paperdiy_feed_error(RenderContext_t* ctx) {
+    return __atomic_load_n(&ctx->error, __ATOMIC_ACQUIRE);
+}
+
+static inline void paperdiy_prepare_feed(RenderContext_t* ctx) {
+    memset(ctx->line_threads, 0xFF, ctx->lines_total);
+    for (int i = 0; i < NUM_RENDER_THREADS; ++i) {
+        atomic_store_explicit(&ctx->paperdiy_committed[i], -1, memory_order_relaxed);
+    }
+    atomic_store_explicit(&ctx->paperdiy_scan_state, 0, memory_order_release);
+}
+
+static inline void IRAM_ATTR paperdiy_try_start(RenderContext_t* ctx) {
+    if (atomic_load_explicit(&ctx->paperdiy_scan_state, memory_order_acquire) != 0) return;
+    // A producer may own every early row. Do not demand more than either
+    // queue can hold, or a full queue could prevent reaching the start gate.
+    int capacity = ctx->line_queues[0].size - 1;
+    for (int i = 1; i < NUM_RENDER_THREADS; ++i) {
+        int other = ctx->line_queues[i].size - 1;
+        if (other < capacity) capacity = other;
+    }
+    // start_frame synchronously fills two four-line bounce buffers.
+    int minimum = ctx->lines_total < 8 ? ctx->lines_total : 8;
+    if (capacity < minimum) {
+        __atomic_fetch_or(&ctx->error, EPD_DRAW_EMPTY_LINE_QUEUE, __ATOMIC_RELEASE);
+    }
+    if (paperdiy_feed_error(ctx)) {
+        int expected = 0;
+        if (atomic_compare_exchange_strong_explicit(&ctx->paperdiy_scan_state, &expected, 2,
+                                                    memory_order_acq_rel, memory_order_acquire)) {
+            // No LCD scan exists to give this semaphore. Wake the coordinator;
+            // it still joins BOTH producers before discarding either queue.
+            xSemaphoreGive(ctx->frame_done);
+        }
+        return;
+    }
+    int needed = epd_lcd_prefill_lines();
+    if (needed < minimum) needed = minimum;
+    if (needed > capacity) needed = capacity;
+    if (needed > ctx->lines_total) needed = ctx->lines_total;
+    for (int i = 0; i < NUM_RENDER_THREADS; ++i) {
+        if (atomic_load_explicit(&ctx->paperdiy_committed[i], memory_order_acquire) < needed - 1) return;
+    }
+    int expected = 0;
+    if (atomic_compare_exchange_strong_explicit(&ctx->paperdiy_scan_state, &expected, 1,
+                                               memory_order_acq_rel, memory_order_acquire)) {
+        epd_lcd_line_source_cb((line_cb_func_t)&retrieve_line_isr, ctx);
+        epd_lcd_start_frame();
+    }
+}
+
+static inline void IRAM_ATTR paperdiy_publish_line(RenderContext_t* ctx, int thread, int row) {
+    // Publish ownership only AFTER committing the payload. The ISR must never
+    // pop another producer's later row through a stale/default owner hint.
+    __atomic_store_n(&ctx->line_threads[row], thread, __ATOMIC_RELEASE);
+    atomic_store_explicit(&ctx->paperdiy_committed[thread], row, memory_order_release);
+    paperdiy_try_start(ctx);
+}
+
+static inline void IRAM_ATTR paperdiy_finish_feed(RenderContext_t* ctx, int thread) {
+    // A producer with no assigned rows must not prevent a short/all-one-worker
+    // frame from starting. Its own previous rows have all been committed.
+    atomic_store_explicit(&ctx->paperdiy_committed[thread], ctx->lines_total, memory_order_release);
+    paperdiy_try_start(ctx);
+}
