@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+// ED047TC1 waveform from epdiy d84d26e; keep the source tables unmodified.
+#if FREEINK_DEVICE_PAPERDIY
+#include "PaperDiyWaveform.h"
+
+#include <string.h>
+
+#include "ed047tc1.h"
+
+const EpdDisplay_t PAPERDIY_DISPLAY = {960, 540, 8, 20, &epdiy_ED047TC1};
+
+// 1920 bytes, statically bounded. Hold unchanged pixels and align only the
+// black-to-white erase with the white-to-black write. Gray transitions retain
+// their panel-specific source sequence. Used only by PaperDIY LCD_CAM TextTurn.
+static uint8_t held_diagonal[30][16][4];
+static EpdWaveformPhases text_phases;
+static const EpdWaveformPhases* text_ranges[1] = {&text_phases};
+static const EpdWaveformMode text_mode = {5, 1, text_ranges};
+static const EpdWaveformMode* text_modes[1] = {&text_mode};
+EpdWaveform PAPERDIY_TEXTTURN_WAVEFORM = {1, 1, text_modes, epdiy_ED047TC1_intervals};
+
+// UI targets are expanded from 1bpp: only black (0) and white (15) occur.
+// A changed endpoint receives the same 15 target-directed scans as TextTurn's
+// accepted B/W transitions, without the opposite-direction gray conditioning.
+// Ordinary UI frames reinforce unchanged endpoints once; a scene boundary
+// reinforces them for all 15 scans. Periodic/manual GC16 remains separate.
+// These are bounded flash-resident tables, not another mutable frame buffer.
+#define UI_HOLD {0, 0, 0, 0}
+#define UI_BLACK {0x55, 0x55, 0x55, 0x55}
+#define UI_WHITE {0xAA, 0xAA, 0xAA, 0xAA}
+#define UI_BLACK_CHANGED {0x15, 0x55, 0x55, 0x55}
+#define UI_WHITE_CHANGED {0xAA, 0xAA, 0xAA, 0xA8}
+#define UI_PHASE(black, white)                                             \
+  {black,   UI_HOLD, UI_HOLD, UI_HOLD, UI_HOLD, UI_HOLD, UI_HOLD, UI_HOLD, \
+   UI_HOLD, UI_HOLD, UI_HOLD, UI_HOLD, UI_HOLD, UI_HOLD, UI_HOLD, white}
+#define UI_CHANGED UI_PHASE(UI_BLACK_CHANGED, UI_WHITE_CHANGED)
+#define UI_SETTLE UI_PHASE(UI_BLACK, UI_WHITE)
+static const uint8_t ui_luts[15][16][4] = {UI_SETTLE,  UI_CHANGED, UI_CHANGED, UI_CHANGED, UI_CHANGED,
+                                           UI_CHANGED, UI_CHANGED, UI_CHANGED, UI_CHANGED, UI_CHANGED,
+                                           UI_CHANGED, UI_CHANGED, UI_CHANGED, UI_CHANGED, UI_CHANGED};
+static const uint8_t ui_transition_luts[15][16][4] = {UI_SETTLE, UI_SETTLE, UI_SETTLE, UI_SETTLE, UI_SETTLE,
+                                                      UI_SETTLE, UI_SETTLE, UI_SETTLE, UI_SETTLE, UI_SETTLE,
+                                                      UI_SETTLE, UI_SETTLE, UI_SETTLE, UI_SETTLE, UI_SETTLE};
+#undef UI_SETTLE
+#undef UI_CHANGED
+#undef UI_PHASE
+#undef UI_WHITE_CHANGED
+#undef UI_BLACK_CHANGED
+#undef UI_WHITE
+#undef UI_BLACK
+#undef UI_HOLD
+// LCD_CAM uses scan count at the existing clock, not phase_times metadata.
+static const EpdWaveformPhases ui_phases = {15, &ui_luts[0][0][0], epd_wp_epdiy_ED047TC1_5_0_times};
+static const EpdWaveformPhases ui_transition_phases = {15, &ui_transition_luts[0][0][0],
+                                                       epd_wp_epdiy_ED047TC1_5_0_times};
+static const EpdWaveformPhases* ui_ranges[1] = {&ui_phases};
+static const EpdWaveformPhases* ui_transition_ranges[1] = {&ui_transition_phases};
+static const EpdWaveformMode ui_mode = {5, 1, ui_ranges};
+static const EpdWaveformMode ui_transition_mode = {5, 1, ui_transition_ranges};
+static const EpdWaveformMode* ui_modes[1] = {&ui_mode};
+static const EpdWaveformMode* ui_transition_modes[1] = {&ui_transition_mode};
+const EpdWaveform PAPERDIY_UI_WAVEFORM = {1, 1, ui_modes, epdiy_ED047TC1_intervals};
+const EpdWaveform PAPERDIY_UI_TRANSITION_WAVEFORM = {1, 1, ui_transition_modes, epdiy_ED047TC1_intervals};
+
+void paperdiy_waveform_init(void) {
+  memcpy(held_diagonal, epd_wp_epdiy_ED047TC1_5_0_data, sizeof(held_diagonal));
+  for (int phase = 0; phase < 30; ++phase) {
+    for (int level = 0; level < 16; ++level) {
+      held_diagonal[phase][level][level / 4] &= ~(3u << (6 - 2 * (level % 4)));
+    }
+  }
+  // Narrow experiment on the pinned 30-phase table: 0 -> 15 originally holds
+  // for 15 scans, then erases for 15. Move that erase to scans 0..14, alongside
+  // 15 -> 0. Keep every pulse, the 30 scans, held diagonals and all other pairs.
+  // LCD_CAM scans at the fixed configured clock; it does not consume the
+  // per-phase hold-time metadata. Do not reuse this shift with a timed backend.
+  for (int phase = 0; phase < 30; ++phase) {
+    const uint8_t erase = phase < 15 ? epd_wp_epdiy_ED047TC1_5_0_data[phase + 15][15][0] & 0xC0u : 0;
+    held_diagonal[phase][15][0] = (held_diagonal[phase][15][0] & 0x3Fu) | erase;
+  }
+  text_phases.phases = 30;
+  text_phases.phase_times = epd_wp_epdiy_ED047TC1_5_0_times;
+  text_phases.luts = &held_diagonal[0][0][0];
+}
+#endif
