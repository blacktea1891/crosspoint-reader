+
+void checkPaperDiyBwCleans(freeink::EpdiyLcdDriver& driver, freeink::EpdBus& bus) {
+  uint8_t fb[4] = {0xFF, 0xFF, 0xFF, 0xFF};
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Full, true);
+  assert(driver.displayCommitted() && lastFullCoverage && lastMode == MODE_GC16);
+  // A sparse home menu/selection update must not restrict the cleaning mask.
+  fb[0] ^= 1;
+  int before = draws;
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Half, true);
+  assert(driver.displayCommitted() && draws == before + 1 && lastFullCoverage && lastMode == MODE_GC16);
+  // Even an identical sleep/startup/30th UI frame needs a physical clean.
+  before = draws;
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Half, true);
+  assert(driver.displayCommitted() && draws == before + 1 && lastFullCoverage && lastMode == MODE_GC16);
+  // Ordinary B/W moves retain sparse DU. Do not fix the clean by flashing every update.
+  for (int update = 1; update <= 90; ++update) {
+    fb[0] ^= 1;
+    const auto mode = update % 30 == 0 ? freeink::RefreshMode::Half : freeink::RefreshMode::Fast;
+    before = draws;
+    driver.display(bus, fb, nullptr, mode, true);
+    assert(driver.displayCommitted() && draws == before + 1);
+    assert(lastFullCoverage == (update % 30 == 0));
+    assert(lastMode == (update % 30 == 0 ? MODE_GC16 : MODE_DU));
+  }
