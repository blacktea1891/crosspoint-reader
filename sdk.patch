+void checkPaperDiyUiProfiles(freeink::EpdiyLcdDriver& driver, freeink::EpdBus& bus) {
+  uint8_t fb[4]{0x55, 0xAA, 0x55, 0xAA};
+  uint8_t previous[32];
+  memcpy(previous, lastTo, 32);
+  for (int update = 1; update <= 90; ++update) {
+    fb[update % 4] ^= 1;
+    const bool due = update % 30 == 0;
+    const bool scene = update % 7 == 0;
+    const auto context = scene ? freeink::RefreshContext::UiTransition : freeink::RefreshContext::Normal;
+    const int before = draws, oldClears = clears, allocations = allocation_calls;
+    driver.displayWithContext(bus, fb, nullptr, due ? freeink::RefreshMode::Half : freeink::RefreshMode::Fast, true,
+                              context);
+    assert(driver.displayCommitted() && draws == before + 1 && clears == oldClears);
+    assert(lastFullCoverage && allocation_calls == allocations);
+    assert(lastMode == (due ? MODE_GC16 : MODE_GL16));
+    assert(lastWaveform == (due ? &epdiy_ED047TC1 : scene ? &PAPERDIY_UI_TRANSITION_WAVEFORM : &PAPERDIY_UI_WAVEFORM));
+    for (int pixel = 0; pixel < 32; ++pixel) assert(lastTo[pixel] == 0 || lastTo[pixel] == 15);
+    assert(std::memcmp(lastFrom, previous, 32) == 0);
+    memcpy(previous, lastTo, 32);
+  }
+  // A gray reader -> B/W menu handoff preserves actual previous gray nibbles.
+  auto* gray = driver.beginGrayscale16();
+  assert(gray);
+  memset(gray, 0x5A, 16);
+  assert(driver.commitGrayscale16WithRefresh(fb, freeink::RefreshMode::Fast));
+  const int allocations = allocation_calls;
+  driver.displayWithContext(bus, fb, nullptr, freeink::RefreshMode::Fast, true, freeink::RefreshContext::UiTransition);
+  assert(lastWaveform == &PAPERDIY_UI_TRANSITION_WAVEFORM && lastFullCoverage);
+  for (const auto old : lastFrom) assert(old == 5 || old == 10);
+  uint8_t history[32];
+  memcpy(history, lastTo, 32);
+  fb[0] ^= 1;
+  failDraw = true;
+  driver.displayWithContext(bus, fb, nullptr, freeink::RefreshMode::Fast, true, freeink::RefreshContext::Normal);
+  assert(!driver.displayCommitted() && std::memcmp(history, lastFrom, 32) == 0);
+  failDraw = false;
+  const int oldClears = clears;
+  driver.displayWithContext(bus, fb, nullptr, freeink::RefreshMode::Fast, true, freeink::RefreshContext::Normal);
+  assert(driver.displayCommitted() && clears == oldClears + 1 && lastMode == MODE_GC16);
+  assert(lastWaveform == &epdiy_ED047TC1 && allocation_calls == allocations);
+  // Reader B/W contexts and explicit cleans must never inherit the UI profile.
+  for (const auto context : {freeink::RefreshContext::ContinuousReading, freeink::RefreshContext::TextOnlyAntiAliasing,
+                             freeink::RefreshContext::ImageReading}) {
+    fb[0] ^= 1;
+    driver.displayWithContext(bus, fb, nullptr, freeink::RefreshMode::Fast, true, context);
