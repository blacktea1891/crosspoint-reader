+  uint8_t lsb[4]{}, msb[4]{};
+  uint8_t previous[32];
+  const int allocations = allocation_calls;
+  for (int page = 0; page < 63; ++page) {
+    const auto mode = page == 0        ? freeink::RefreshMode::Full
+                      : page % 30 == 0 ? freeink::RefreshMode::Half
+                                       : freeink::RefreshMode::Fast;
+    base[page % 4] ^= 0x55;
+    lsb[page % 4] ^= 0x20;
+    msb[page % 4] ^= 0x40;
