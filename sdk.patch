+    assert(lastMode == (mode == freeink::RefreshMode::Fast ? MODE_GL16 : MODE_GC16));
+    if (mode != freeink::RefreshMode::Fast) assert(lastFullCoverage);
+    assert(lastWaveform == (mode == freeink::RefreshMode::Fast ? &PAPERDIY_TEXTTURN_WAVEFORM : &epdiy_ED047TC1));
+    if (page) assert(std::memcmp(previous, lastFrom, 32) == 0);
+    std::memcpy(previous, lastTo, 32);
+    driver.cleanupGrayscaleBuffers(bus, base);
+    assert(draws == before + 1);  // cleanup must not replace the gray baseline with B/W
+  }
+  assert(allocation_calls == allocations);
+  const int before = draws;
+  driver.displayGrayscaleBaseWithContext(bus, base, freeink::RefreshMode::Fast, false, freeink::RefreshContext::Normal);
+  driver.cleanupGrayscaleBuffers(bus, nullptr);  // cancelled page never touches glass
+  assert(draws == before);
+  base[0] ^= 1;
+  driver.displayGrayscaleBaseWithContext(bus, base, freeink::RefreshMode::Fast, false, freeink::RefreshContext::Normal);
+  driver.cleanupGrayscaleBuffers(bus, base);  // scratch failure falls back once
+  assert(draws == before + 1 && lastMode == MODE_DU);
