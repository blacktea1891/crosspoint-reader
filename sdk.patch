diff --git a/libs/hardware/BoardPaperDIY/src/PaperDiyEpdiyConfig.cpp b/libs/hardware/BoardPaperDIY/src/PaperDiyEpdiyConfig.cpp
new file mode 100644
--- /dev/null
+++ b/libs/hardware/BoardPaperDIY/src/PaperDiyEpdiyConfig.cpp
@@ -0,0 +1,61 @@
+#if FREEINK_PAPERDIY_EPDIY
+#include <EpdiyLcd.h>
+#include <PaperDiyBoard.h>
+#include <driver/gpio.h>
+#include <esp_log.h>
+namespace {
+// Preserve the known-working M5GFX PaperDIY rail sequence (OE/boost/SPV).
+// The PMU hook only controls PYG2; factory VCOM is never changed.
+bool prepare() {
+  pinMode(45, OUTPUT);
+  pinMode(46, OUTPUT);
+  digitalWrite(46, LOW);
+  digitalWrite(45, LOW);
+  return freeink::paperdiy::setEpdPower(true);
+}
+bool powerOn() {
+  digitalWrite(45, HIGH);
+  delayMicroseconds(100);
+  digitalWrite(46, HIGH);
+  delayMicroseconds(100);
+  // STV is configured by the LCD backend through gpio_config, not Arduino's
+  // peripheral manager. Do not steal/reconfigure it with pinMode here.
+  if (gpio_set_level(GPIO_NUM_17, 1) != ESP_OK) {
+    digitalWrite(46, LOW);
+    digitalWrite(45, LOW);
+    return false;
+  }
+  delay(1);
+  return true;
+}
+void powerOff() {
+  delay(1);
+  digitalWrite(46, LOW);
+  delayMicroseconds(10);
+  digitalWrite(45, LOW);
+  delayMicroseconds(100);
+  if (gpio_set_level(GPIO_NUM_17, 0) != ESP_OK) ESP_LOGE("PaperDIY", "STV park-low failed");
+}
+}  // namespace
+
+namespace freeink {
+const EpdiyLcdConfig& paperDiyEpdiyConfig() {
+  // ED047TC1's upstream epdiy 8-bit LCD timing (d84d26e). Do not use the
+  // Read Pico E0470 glass's timing, polarity calibration or waveform.
+  static const EpdiyLcdConfig config = {
+      {6, 14, 7, 12, 9, 11, 8, 10, -1, -1, -1, -1, -1, -1, -1, -1},
+      16,
+      18,
+      13,
+      15,
+      17,
+      8,
+      20,
+      {4, 4, 4, 60},
+      8,
+      {prepare, powerOn, powerOff, nullptr},
+  };
+  return config;
+}
+}  // namespace freeink
+#endif
