+void checkPaperDiyTurns(freeink::EpdiyLcdDriver& driver, freeink::EpdBus& bus) {
+  // Use the real waveform: 30 phases, all 256 transitions in every phase.
+  paperdiy_waveform_init();
+  const auto* source = epdiy_ED047TC1.mode_data[2]->range_data[0];
+  const auto* held = PAPERDIY_TEXTTURN_WAVEFORM.mode_data[0]->range_data[0];
+  assert(source->phases == 30 && held->phases == 30);
+  for (int phase = 0; phase < 30; ++phase) {
+    assert(source->phase_times[phase] == held->phase_times[phase]);
+    for (int to = 0; to < 16; ++to) for (int from = 0; from < 16; ++from) {
+      const int pos = (phase * 16 + to) * 4 + from / 4;
+      const int shift = 6 - 2 * (from % 4);
+      const int action = (held->luts[pos] >> shift) & 3;
+      const int expected = to == from ? 0 : (to == 15 && from == 0 ? (phase < 15 ? 2 : 0)
+                                                                 : ((source->luts[pos] >> shift) & 3));
+      assert(action == expected);
+    }
+  }
+  // Both pure B/W directions now start together. Preserve all 15 drive scans;
+  // do not obtain an apparently quieter turn by dropping the old-text erase.
