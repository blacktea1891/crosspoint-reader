+void checkPaperDiyTurns(freeink::EpdiyLcdDriver& driver, freeink::EpdBus& bus) {
+  // Use the real waveform: 30 phases, all 256 transitions in every phase.
+  paperdiy_waveform_init();
+  const auto* source = epdiy_ED047TC1.mode_data[2]->range_data[0];
+  const auto* held = PAPERDIY_TEXTTURN_WAVEFORM.mode_data[0]->range_data[0];
+  assert(source->phases == 30 && held->phases == 30);
