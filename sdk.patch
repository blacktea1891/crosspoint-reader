 void epdiyLcdDeepSleep() {
   if (!g_started) return;
+#if FREEINK_DEVICE_PAPERDIY && FREEINK_PAPERDIY_SHUTDOWN_NEUTRAL_FRAME
+  // Shutdown-only experiment: flush the source/gate scan with HOLD (00), not
+  // another black/white phase. The LCD push path borrows an existing idle feed
+  // buffer and waits for its one full scan. Never change the image/history or
+  // run this on an unknown/failed baseline. Normal turns/End are untouched.
+  if (g_baselineKnown) {
+    if (!g_powerReady) epd_poweron();
+    if (g_powerReady) {
+#if FREEINK_PAPERDIY_REFRESH_AUDIT
+      uint32_t starts = 0, dones = 0, afterStarts = 0, afterDones = 0;
+      epd_lcd_audit_counts(&starts, &dones);
+      traceShutdown("neutral-hold-begin");
+#endif
+      // In this LCD implementation color 2 selects the all-zero HOLD pattern;
+      // its 'time' argument is unused. Geometry and frame clock stay unchanged.
+      epd_push_pixels(epd_full_screen(), 0, 2);
+#if FREEINK_PAPERDIY_REFRESH_AUDIT
+      epd_lcd_audit_counts(&afterStarts, &afterDones);
+      if (afterStarts - starts != 1 || afterDones - dones != 1) {
+        ESP_LOGE("EpdiyLcd", "Shutdown neutral hold scan count mismatch");
+      }
+      if (g_refreshAuditObserver != nullptr) {
+        char line[144];
+        snprintf(line, sizeof(line), "[PD-OFF-DISPLAY] stage=neutral-hold-complete seq=%u scan=%u/%u expected=1",
+                 static_cast<unsigned>(g_refreshAuditSequence), static_cast<unsigned>(afterStarts - starts),
+                 static_cast<unsigned>(afterDones - dones));
+        g_refreshAuditObserver(line);
+      }
+#endif
+    } else {
+      ESP_LOGE("EpdiyLcd", "Shutdown neutral hold skipped: panel power-on failed");
+#if FREEINK_PAPERDIY_REFRESH_AUDIT
+      traceShutdown("neutral-hold-skipped-power");
+#endif
+    }
+  } else {
+#if FREEINK_PAPERDIY_REFRESH_AUDIT
+    traceShutdown("neutral-hold-skipped-baseline");
+#endif
+  }
+#endif
   (void)epd_poweroff();
+#if FREEINK_DEVICE_PAPERDIY
+  g_shutdownDeinit = true;
+#if FREEINK_PAPERDIY_REFRESH_AUDIT
+  traceShutdown("board-parked-before-deinit");
+#endif
+#endif
   epdiyLcdEnd();
+#if FREEINK_DEVICE_PAPERDIY
+#if FREEINK_PAPERDIY_REFRESH_AUDIT
+  traceShutdown("display-resources-released");
+#endif
+  g_shutdownDeinit = false;
+#endif
+}
+
