+    assert(source->phase_times[phase] == held->phase_times[phase]);
+    for (int to = 0; to < 16; ++to)
+      for (int from = 0; from < 16; ++from) {
+        const int pos = (phase * 16 + to) * 4 + from / 4;
+        const int shift = 6 - 2 * (from % 4);
