diff --git a/libs/hardware/BoardConfig/include/PaperDiyBoard.h b/libs/hardware/BoardConfig/include/PaperDiyBoard.h
new file mode 100644
--- /dev/null
+++ b/libs/hardware/BoardConfig/include/PaperDiyBoard.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <M5Pm1.h>
+#include <PaperDiyPowerClicks.h>
+
+namespace freeink::paperdiy {
+
+inline bool ensureBooted() {
+  static bool ready = false;
+  if (ready) return true;
+  using namespace m5pm1;
+  beginBus();
+  // PYG2 supplies the EPD; PYG3 is the active-low charger status input.
+  ready = updateRegChecked(REG_GPIO_FUNC0, 0xF0, 0) && updateRegChecked(REG_GPIO_MODE, 0x08, 0x04) &&
+          updateRegChecked(REG_GPIO_DRV, 0x04, 0) && updateRegChecked(REG_GPIO_PULL0, 0xC0, 0x40) &&
+          configureAppPowerButton() && updateRegChecked(REG_BTN_CFG_2, 0x01, 0x01);
+  return ready;
+}
+
+inline bool setEpdPower(bool enabled) {
+  if (!ensureBooted()) return false;
+  if (!m5pm1::updateRegChecked(m5pm1::REG_GPIO_OUT, 0x04, enabled ? 0x04 : 0)) return false;
+  delay(10);
+  return true;
+}
+
+inline bool& powerOffRequested() {
+  static bool pending = false;
+  return pending;
+}
+
+inline bool consumePowerOffRequest() {
+  const bool pending = powerOffRequested();
+  powerOffRequested() = false;
+  return pending;
+}
+
+inline PowerClicks& powerClicks() {
+  static PowerClicks clicks;
+  return clicks;
+}
+
+inline void discardWakePowerClick() {
+  powerClicks().discardWakeClick();
+  powerOffRequested() = false;
+  uint8_t status = 0;
+  // Drain the PMIC's read-clear wake event, including a Single/Double already
+  // pending in software. On I2C failure suppression survives until a successful
+  // poll sees physical release; never hang setup waiting for the PMIC.
+  if (ensureBooted() && m5pm1::readButtonStatus(&status)) {
+    (void)powerClicks().update(static_cast<uint32_t>(millis()), (status & m5pm1::BTN_EVENT) != 0,
+                               (status & m5pm1::BTN_PRESSED) != 0);
+  }
+}
+
+inline bool pollPowerButtonClicked(unsigned long nowMs) {
+  static unsigned long lastPollMs = 0;
+  // Raw events have no click count. Poll fast enough to distinguish two
+  // physical presses; do not use IRQ_STATUS3, which needs a configured IRQ pin.
+  if (nowMs - lastPollMs < 40) return false;
+  lastPollMs = nowMs;
+  if (!ensureBooted()) return false;
+  uint8_t status = 0;
+  if (!m5pm1::readButtonStatus(&status)) return false;
+  const auto event = powerClicks().update(static_cast<uint32_t>(nowMs), (status & m5pm1::BTN_EVENT) != 0,
+                                          (status & m5pm1::BTN_PRESSED) != 0);
+  if (event == PowerClicks::Event::Shutdown) powerOffRequested() = true;
+  return event == PowerClicks::Event::Single;
+}
+
+}  // namespace freeink::paperdiy
diff --git a/libs/hardware/BoardConfig/include/PaperDiyPowerClicks.h b/libs/hardware/BoardConfig/include/PaperDiyPowerClicks.h
new file mode 100644
--- /dev/null
+++ b/libs/hardware/BoardConfig/include/PaperDiyPowerClicks.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <stdint.h>
+
+namespace freeink::paperdiy {
+
+// BTN_EVENT is read-clear even without a configured PMIC IRQ pin. Defer the
+// single action so a double click cannot start a refresh and then cut its power.
+// Keep the PMIC's long-hold/download configuration untouched.
+class PowerClicks {
+ public:
+  enum class Event : uint8_t { None, Single, Shutdown };
+  static constexpr uint32_t windowMs = 450;
+
+  void discardWakeClick() {
+    singlePending_ = false;
+    doublePending_ = false;
+    discardUntilRelease_ = true;
+  }
+
+  Event update(uint32_t now, bool event, bool held) {
+    if (discardUntilRelease_) {
+      if (!held) discardUntilRelease_ = false;
+      return Event::None;
+    }
+    if (event && !doublePending_) {
+      if (singlePending_ && static_cast<uint32_t>(now - firstAt_) <= windowMs) {
+        singlePending_ = false;
+        doublePending_ = true;
+      } else {
+        const bool expired = singlePending_;
+        singlePending_ = true;
+        firstAt_ = now;
+        if (expired) return Event::Single;
+      }
+    }
+    if (doublePending_ && !held) {
+      doublePending_ = false;
+      return Event::Shutdown;
+    }
+    if (singlePending_ && !held && static_cast<uint32_t>(now - firstAt_) >= windowMs) {
+      singlePending_ = false;
+      return Event::Single;
+    }
+    return Event::None;
+  }
+
+ private:
+  uint32_t firstAt_ = 0;
+  bool singlePending_ = false;
+  bool doublePending_ = false;
+  bool discardUntilRelease_ = false;
+};
+
+}  // namespace freeink::paperdiy
