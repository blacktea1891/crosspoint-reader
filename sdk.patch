+void checkPaperDiyRecovery(freeink::EpdiyLcdDriver& driver, freeink::EpdBus& bus) {
+  uint8_t fb[4]{0x55, 0xAA, 0x55, 0xAA};
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Fast, true);
+  const int allocations = allocation_calls;
+  int before = draws, oldClears = clears;
+  // Recovery invalidates even a software-"known" history. The identical target
+  // must still clear from unknown glass, then drive every row/column from white.
+  driver.requestResync(1);
+  assert(!driver.displayCommitted() && !powered && draws == before && clears == oldClears);
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Fast, true);
+  assert(driver.displayCommitted() && draws == before + 1 && clears == oldClears + 1);
+  assert(lastMode == MODE_GC16 && lastFullCoverage);
+  for (const auto old : lastFrom) assert(old == 15);
+  before = draws;
+  oldClears = clears;
+  driver.requestResync(1);
+  railsOk = false;
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Fast, true);
+  assert(!driver.displayCommitted() && draws == before && clears == oldClears);
+  railsOk = true;
+  failDraw = true;
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Fast, true);
+  assert(!driver.displayCommitted());
+  failDraw = false;
+  before = draws;
+  oldClears = clears;
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Fast, true);
+  assert(driver.displayCommitted() && draws == before + 1 && clears == oldClears + 1);
+  assert(lastMode == MODE_GC16 && lastFullCoverage);
+  for (const auto old : lastFrom) assert(old == 15);
+  // A zero-pass grayscale cancellation is not a panel recovery request.
+  oldClears = clears;
+  driver.requestResync(0);
+  fb[0] ^= 1;
+  driver.display(bus, fb, nullptr, freeink::RefreshMode::Fast, true);
+  assert(driver.displayCommitted() && clears == oldClears && lastMode == MODE_DU && !lastFullCoverage);
+  // Recovery also cancels an unfinished native plane and preserves an exact
+  // newly rendered 16-gray target through the unknown-baseline clear.
+  auto* plane = driver.beginGrayscale16();
+  assert(plane);
+  std::memset(plane, 0x55, 16);
+  driver.requestResync(1);
+  assert(!driver.commitGrayscale16(fb));
+  plane = driver.beginGrayscale16();
+  assert(plane);
+  for (int p = 0; p < 16; ++p) plane[p] = static_cast<uint8_t>(p * 17);
+  oldClears = clears;
+  assert(driver.commitGrayscale16WithRefresh(fb, freeink::RefreshMode::Fast));
+  assert(clears == oldClears + 1 && lastMode == MODE_GC16 && lastFullCoverage);
+  for (int p = 0; p < 32; ++p) assert(lastTo[p] == p / 2 && lastFrom[p] == 15);
+  assert(allocation_calls == allocations);
