diff --git a/libs/display/FreeInkDisplay/src/driver/LgfxUiRegions.h b/libs/display/FreeInkDisplay/src/driver/LgfxUiRegions.h
new file mode 100644
--- /dev/null
+++ b/libs/display/FreeInkDisplay/src/driver/LgfxUiRegions.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+namespace freeink {
+namespace detail {
+
+struct LgfxUiRect {
+  uint16_t x, y, w, h;
+  uint32_t area() const { return static_cast<uint32_t>(w) * h; }
+};
+
+// Compare against the existing 8-bit canvas, before replacing it with the next
+// 1-bit frame. Native coordinates already include the renderer's orientation.
+// Eight rectangles bound stack use to < 100 bytes; no extra framebuffer.
+struct LgfxUiRegions {
+  std::array<LgfxUiRect, 8> rects{};
+  uint8_t count = 0;
+  bool large = false;
+
+  static LgfxUiRegions find(const uint8_t* next, const uint8_t* previous, uint16_t width, uint16_t height) {
+    LgfxUiRegions result;
+    if (!next || !previous || width == 0 || height == 0 || width % 8 != 0) {
+      result.large = true;
+      return result;
+    }
+    constexpr uint16_t bandHeight = 32;
+    uint32_t area = 0;
+    for (uint16_t y = 0; y < height; y += bandHeight) {
+      const uint16_t endY = std::min<uint16_t>(height, y + bandHeight);
+      uint16_t left = width, right = 0;
+      for (uint16_t row = y; row < endY; ++row) {
+        for (uint16_t byte = 0; byte < width / 8; ++byte) {
+          const uint8_t value = next[static_cast<uint32_t>(row) * (width / 8) + byte];
+          const uint32_t offset = static_cast<uint32_t>(row) * width + byte * 8;
+          for (uint8_t bit = 0; bit < 8; ++bit) {
+            if (previous[offset + bit] != ((value & (0x80 >> bit)) ? 0xFF : 0x00)) {
+              // Byte alignment also satisfies Panel_EPD's pixel-pair alignment.
+              left = std::min<uint16_t>(left, byte * 8);
+              right = std::max<uint16_t>(right, byte * 8 + 8);
+              break;
+            }
+          }
+        }
+      }
+      if (left == width) continue;
+      LgfxUiRect rect{left, y, static_cast<uint16_t>(right - left), static_cast<uint16_t>(endY - y)};
+      bool merged = false;
+      if (result.count != 0) {
+        auto& last = result.rects[result.count - 1];
+        const uint16_t mergedLeft = std::min(last.x, rect.x);
+        const uint16_t mergedRight = std::max<uint16_t>(last.x + last.w, right);
+        const uint32_t sum = last.area() + rect.area();
+        const uint32_t joined = static_cast<uint32_t>(mergedRight - mergedLeft) * (last.h + rect.h);
+        if (last.y + last.h == y && joined <= sum + sum / 4) {
+          area -= last.area();
+          last = {mergedLeft, last.y, static_cast<uint16_t>(mergedRight - mergedLeft),
+                  static_cast<uint16_t>(last.h + rect.h)};
+          area += last.area();
+          merged = true;
+        }
+      }
+      if (!merged) {
+        if (result.count == result.rects.size()) {
+          result.large = true;
+          return result;
+        }
+        result.rects[result.count++] = rect;
+        area += rect.area();
+      }
+      // Large content changes get one explicit clean, never a periodic counter.
+      if (area > static_cast<uint32_t>(width) * height / 2) {
+        result.large = true;
+        return result;
+      }
+    }
+    return result;
+  }
+};
+
+}  // namespace detail
+}  // namespace freeink
diff --git a/libs/hardware/BoardConfig/include/PaperDiyBoard.h b/libs/hardware/BoardConfig/include/PaperDiyBoard.h
new file mode 100644
--- /dev/null
+++ b/libs/hardware/BoardConfig/include/PaperDiyBoard.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <M5Pm1.h>
+
+namespace freeink::paperdiy {
+
+inline bool ensureBooted() {
+  static bool ready = false;
+  if (ready) return true;
+  using namespace m5pm1;
+  beginBus();
+  // PYG2 supplies the EPD; PYG3 is the active-low charger status input.
+  ready = updateRegChecked(REG_GPIO_FUNC0, 0xF0, 0) && updateRegChecked(REG_GPIO_MODE, 0x08, 0x04) &&
+          updateRegChecked(REG_GPIO_DRV, 0x04, 0) && updateRegChecked(REG_GPIO_PULL0, 0xC0, 0x40) &&
+          configureAppPowerButton();
+  return ready;
+}
+
+inline bool setEpdPower(bool enabled) {
+  if (!ensureBooted()) return false;
+  if (!m5pm1::updateRegChecked(m5pm1::REG_GPIO_OUT, 0x04, enabled ? 0x04 : 0)) return false;
+  delay(10);
+  return true;
+}
+
+inline bool pollPowerButtonClicked(unsigned long nowMs) {
+  static unsigned long lastPollMs = 0;
+  if (nowMs - lastPollMs < 250) return false;
+  lastPollMs = nowMs;
+  if (!ensureBooted()) return false;
+  uint8_t status = 0;
+  return m5pm1::readButtonStatus(&status) && (status & m5pm1::BTN_EVENT) != 0;
+}
+
+}  // namespace freeink::paperdiy
