+void checkValid(const KeyboardEntryActivity& kb) {
+  const auto& layout = kb.currentLayout();
+  assert(kb.selRow >= 0 && kb.selRow < layout.rowCount);
+  assert(kb.selCol >= 0 && kb.selCol < layout.rows[kb.selRow].count);
