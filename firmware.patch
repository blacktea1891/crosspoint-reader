+  // earlier selection. This is not just a diff against the last clean image.
+  assert(d.hasPendingMaintenance()); lgfx::updates.clear(); d.runMaintenance(bus);
+  assert(!d.hasPendingMaintenance() && !lgfx::updates.empty());
+  for(const auto u:lgfx::updates) assert(u.mode==lgfx::epd_mode::epd_text);
+  for(int x=0;x<400;x+=72) {
+    bool covered=false;
+    for(const auto u:lgfx::updates) covered|=x>=u.rect.x && x<u.rect.x+u.rect.w;
+    assert(covered);
+  }
+  queuedWithoutWait(); equalFrame(); lgfx::updates.clear(); d.runMaintenance(bus); assert(lgfx::updates.empty());
