+bool HomeActivity::handlePaperDiyNavigation(const bool isCarousel) {
+  const bool horizontal = mappedInput.wasReleased(MappedInputManager::Button::Up);
+  const bool vertical = mappedInput.wasReleased(MappedInputManager::Button::Down);
+  if (!horizontal && !vertical) return false;
+
+  const int bookCount = static_cast<int>(recentBooks.size());
+  const int menuCount = getMenuItemCount() - bookCount;
+  const bool coversFocused = selectorIndex < bookCount;
+  if (isCarousel) {
+    if (horizontal) {
+      if (coversFocused) {
+        selectorIndex = ButtonNavigator::nextIndex(selectorIndex, bookCount);
+        lastCarouselBookIndex = selectorIndex;
+      } else {
+        selectorIndex = bookCount + ButtonNavigator::nextIndex(selectorIndex - bookCount, menuCount);
+      }
+    } else if (bookCount > 0) {
+      if (coversFocused) {
+        lastCarouselBookIndex = selectorIndex;
+        selectorIndex = bookCount;
+      } else {
+        selectorIndex = std::clamp(lastCarouselBookIndex, 0, bookCount - 1);
+      }
