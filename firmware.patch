+typedef struct {int width,height;uint8_t bus_width;int bus_speed;const EpdWaveform* default_waveform;} EpdDisplay_t;
+''')
+    (work / 'check.c').write_text('''#include <assert.h>
+#include "PaperDiyWaveform.h"
+int main(void) {
+  paperdiy_waveform_init();
+  assert(PAPERDIY_DISPLAY.width==960 && PAPERDIY_DISPLAY.height==540 && PAPERDIY_DISPLAY.bus_width==8);
+  assert(PAPERDIY_DISPLAY.default_waveform==&epdiy_ED047TC1);
+  const EpdWaveformPhases* original=epdiy_ED047TC1.mode_data[2]->range_data[0];
+  const EpdWaveformPhases* held=PAPERDIY_TEXTTURN_WAVEFORM.mode_data[0]->range_data[0];
+  assert(epdiy_ED047TC1.mode_data[2]->type==5 && held->phases==original->phases);
+  for(int phase=0;phase<held->phases;++phase) {
+    assert(held->phase_times[phase]==original->phase_times[phase]);
+    for(int to=0;to<16;++to) for(int from=0;from<16;++from) {
+      int offset=(phase*16+to)*4+from/4,shift=6-2*(from%4);
+      int a=(held->luts[offset]>>shift)&3,b=(original->luts[offset]>>shift)&3;
+      assert(a==(to==from?0:(to==15 && from==0?(phase<15?2:0):b)));
+    }
+  }
+  int oldErase=0,newErase=0,changed=0;
