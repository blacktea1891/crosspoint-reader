+#include <cstddef>
+#include <cstdint>
+#include <vector>
+namespace freeink {
+enum class GrayscaleMode { Overlay };
+enum class GrayscaleBase { Separate, Combined };
+enum class GrayscaleEncoding { OverlayMasks };
+struct GrayscaleCapabilities { bool asyncBase=false, stripUploads=true; GrayscaleBase base=GrayscaleBase::Separate; };
+}
+struct EInkDisplay {
+  enum RefreshMode { FULL_REFRESH, HALF_REFRESH, FAST_REFRESH };
+  enum class RefreshContext { Normal, ContinuousReading, TextOnlyAntiAliasing, ImageReading };
+  enum { GRAY_PLANE_LSB, GRAY_PLANE_MSB };
+  static constexpr uint16_t DISPLAY_WIDTH=960, DISPLAY_HEIGHT=540;
+  struct Record { RefreshMode mode; bool off; RefreshContext context; bool async; };
+  inline static std::vector<Record> records;
+  inline static bool committed=true;
+  inline static int resyncs=0;
+  inline static RefreshMode grayMode=FAST_REFRESH, nativeMode=FAST_REFRESH;
+  template<class... T> EInkDisplay(T...) {}
+  void displayBuffer(RefreshMode mode, bool off, RefreshContext context) { records.push_back({mode,off,context,false}); }
+  void displayBufferAsyncNoShadow(RefreshMode mode, RefreshContext context) { records.push_back({mode,false,context,true}); }
+  void refreshDisplay(RefreshMode mode, bool off) { displayBuffer(mode,off,RefreshContext::Normal); }
+  bool displayCommitted() const { return committed; }
+  bool hasPendingMaintenance() const { return false; }
+  void runMaintenance() {}
+  freeink::GrayscaleCapabilities grayscaleCapabilities(freeink::GrayscaleMode) const { return {}; }
+  bool displayGrayscaleBase(freeink::GrayscaleMode, RefreshMode mode, bool) { grayMode=mode; return true; }
+  void displayGrayscaleBase(RefreshMode mode, bool, RefreshContext) { grayMode=mode; }
+  void requestResync(uint8_t passes=1) { resyncs+=passes; }
+  void setRefreshAuditObserver(void (*)(const char*)) {}
+#define VOID_METHOD(name) template<class... T> void name(T...) const {}
+  VOID_METHOD(abortPostRefresh) VOID_METHOD(begin) VOID_METHOD(cancelGrayscale16)
+  VOID_METHOD(cleanupGrayscaleBuffers) VOID_METHOD(clearScreen) VOID_METHOD(copyGrayscaleBuffers)
