+    bool covered=false;
+    for(const auto u:lgfx::updates) covered|=touches(u.rect,row,row+64);
+    assert(covered);
+  }
+  equalFrame();
+  // The update task may scan frames before the next request is queued. The
+  // driver then still queues both bars without waiting and paints the right
+  // image, but the second bar starts later: no simultaneous start is claimed.
+  lgfx::framesBetweenRequests=3;
+  paint(at,40,64,460,true); at=rows[5]; paint(at,40,64,460,false);
+  lgfx::updates.clear();
+  d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal);
+  assert(lgfx::updates.size()==2); localOnly();
+  assert(lgfx::updates[1].startFrame>lgfx::updates[0].startFrame);
+  lgfx::framesBetweenRequests=0;
+  frame.fill(255); d.display(bus,frame.data(),nullptr,RefreshMode::Full,false);
+  // Input during cleanup leaves the rectangles not yet queued pending. A
+  // queued waveform always runs to completion.
+  paint(0,0,8,8,false); paint(900,500,8,8,false);
+  lgfx::updates.clear();
+  d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal);
+  assert(lgfx::updates.size()==2); localOnly();  // two islands, queued without a wait
