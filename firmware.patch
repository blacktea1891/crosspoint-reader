+    page.handleManageInput();
+    assert(page.mainFocus_==Focus::Tabs);
+    page.mappedInput.released=int(next);
+    page.handleMainTabInput();
+    assert(page.mainTab_==Tab::Shelf && page.mainFocus_==Focus::Tabs);
