+#undef VOID_METHOD
+#define BOOL_METHOD(name) bool name() const { return false; }
+  BOOL_METHOD(canUseTextTransition) BOOL_METHOD(commitGrayscale16) BOOL_METHOD(isInverted)
+  BOOL_METHOD(supportsAsyncRefresh) BOOL_METHOD(supportsContinuousImageReading)
+  BOOL_METHOD(supportsReaderTransitions) BOOL_METHOD(supportsTextOnlyCombinedBase) BOOL_METHOD(toggleInverted)
+#undef BOOL_METHOD
+  uint8_t* beginGrayscale16() const { return nullptr; }
+  uint8_t* getFrameBuffer() const { return nullptr; }
+  uint8_t* lendBuildStorage(uint32_t*) { return nullptr; }
+  uint16_t getDisplayWidth() const { return 960; }
+  uint16_t getDisplayHeight() const { return 540; }
+  uint16_t getDisplayWidthBytes() const { return 120; }
+  uint32_t getBufferSize() const { return 64800; }
