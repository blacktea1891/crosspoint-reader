 void HalDisplay::displayBuffer(HalDisplay::RefreshMode mode, bool turnOffScreen, DisplayRefreshContext context) {
+#if FREEINK_DEVICE_PAPERDIY
+  const bool normalContext = context == DisplayRefreshContext::Normal;
+  if (paperDiyRefreshBudget.needsClean(mode == FAST_REFRESH, normalContext)) mode = HALF_REFRESH;
+#endif
