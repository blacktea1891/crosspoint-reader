+++ b/test/test_paperdiy_idle_clean.py
@@ -0,0 +1,136 @@
+"""Execute the production render loop with controlled notifications and input."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+source = (ROOT / "src/activities/ActivityManager.cpp").read_text(encoding="utf-8")
+start = source.index("void ActivityManager::renderTaskLoop()")
+brace = source.index("{", start)
+depth, end = 1, brace + 1
+while depth:
+    depth += (source[end] == "{") - (source[end] == "}")
+    end += 1
+loop = source[start:end]
+
+PROGRAM = r'''
+#include <atomic>
+#include <cassert>
+#include <cstdint>
+#include <utility>
+#include <vector>
+using TickType_t=uint32_t;
+using TaskHandle_t=void*;
+constexpr TickType_t portMAX_DELAY=0xffffffff;
+constexpr int pdTRUE=1,eIncrement=1;
+TickType_t pdMS_TO_TICKS(unsigned n) { return n; }
+#define taskENTER_CRITICAL(x) ((void)0)
+#define taskEXIT_CRITICAL(x) ((void)0)
+int renderLocks=0,powerLocks=0,acknowledgments=0;
+struct RenderLock {
+  bool owns=true;
+  RenderLock() { assert(renderLocks==0); ++renderLocks; }
+  ~RenderLock() { unlock(); }
+  void unlock() { if(owns) { --renderLocks; owns=false; } }
+};
+struct HalPowerManager { struct Lock { Lock(){++powerLocks;} ~Lock(){--powerLocks;} }; };
+struct { int screenInverted=0; } SETTINGS;
+struct Display {
+  bool pending=false;
+  int cleanCount=0;
+  void setInverted(bool) {}
+  bool hasPendingMaintenance() const { assert(renderLocks==1); return pending; }
+  void runMaintenance() { assert(renderLocks==1 && powerLocks==1); ++cleanCount; pending=false; }
+} display;
+struct Activity {
+  bool releasesLock=false,createsDirty=true;
+  uint32_t delay=0;
+  int renders=0,idles=0;
+  uint32_t idleRenderDelayMs() const { return delay; }
+  void render(RenderLock&& lock) {
+    ++renders; display.pending=createsDirty;
+    if(releasesLock) lock.unlock();
+  }
+  void renderIdle(uint32_t) { assert(renderLocks==1); ++idles; }
+};
+struct ActivityManager {
+  enum class PendingAction { None, Switch };
+  Activity* currentActivity=nullptr;
+  std::atomic<PendingAction> pendingAction{PendingAction::None};
+  std::atomic<uint32_t> idleRenderGeneration{0};
+  std::atomic<bool> requestedUpdate{false};
+  TaskHandle_t waitingTaskHandle=nullptr;
+  bool idleRenderCancelled(uint32_t g) const {
+    return g!=idleRenderGeneration.load() || pendingAction.load()!=PendingAction::None || requestedUpdate.load();
+  }
+  void renderTaskLoop();
+};
+struct Step { bool foreground; bool input=false,requested=false,switching=false; };
+struct Done {};
+std::vector<Step> steps;
+std::vector<TickType_t> waits;
+size_t index=0;
+ActivityManager* manager=nullptr;
+uint32_t ulTaskNotifyTake(int,TickType_t wait) {
+  assert(renderLocks==0 && powerLocks==0);
+  waits.push_back(wait);
+  if(index==steps.size()) throw Done{};
+  const auto step=steps[index++];
+  if(step.input) ++manager->idleRenderGeneration;
+  manager->requestedUpdate=step.requested;
+  manager->pendingAction=step.switching?ActivityManager::PendingAction::Switch:ActivityManager::PendingAction::None;
+  // A waiter installed during an idle pass must not be acknowledged by it.
+  manager->waitingTaskHandle=reinterpret_cast<void*>(1);
+  return step.foreground ? 1 : 0;
+}
+void xTaskNotify(TaskHandle_t,int,int) { ++acknowledgments; }
+@LOOP@
+void run(ActivityManager& m,std::initializer_list<Step> s) {
+  manager=&m; steps=s; waits.clear(); index=0; acknowledgments=0; display={};
+  try { m.renderTaskLoop(); } catch(const Done&) {}
+  assert(renderLocks==0 && powerLocks==0);
+}
+int main() {
+  for(bool release: {false,true}) {
+    Activity a; a.releasesLock=release;
+    ActivityManager m; m.currentActivity=&a;
+#if FREEINK_DEVICE_PAPERDIY
+    run(m,{{true},{true},{true},{false}});
+    assert(a.renders==3 && display.cleanCount==1 && acknowledgments==3);
+    assert(waits==std::vector<TickType_t>({portMAX_DELAY,1200,1200,1200,portMAX_DELAY}));
+    assert(m.waitingTaskHandle!=nullptr);
+    run(m,{{true},{false,true},{false,true},{false}});
+    assert(display.cleanCount==1 && acknowledgments==1);
+    assert(waits==std::vector<TickType_t>({portMAX_DELAY,1200,1200,1200,portMAX_DELAY}));
+    run(m,{{true},{false,false,true},{true}});
+    assert(display.cleanCount==0 && acknowledgments==2);
+    run(m,{{true},{false,false,false,true}});
+    assert(display.cleanCount==0 && acknowledgments==1);
+    // An activity's existing 400-ms idle hook precedes UI maintenance.
+    a.delay=400; a.idles=0;
+    run(m,{{true},{false},{false}});
+    assert(a.idles==1 && display.cleanCount==1);
+    assert(waits==std::vector<TickType_t>({portMAX_DELAY,400,1200,portMAX_DELAY}));
+#endif
+    // Reader cache idle scheduling and boards without this policy are preserved.
+    a.delay=400; a.createsDirty=false; a.idles=0;
+    run(m,{{true},{false}});
+    assert(a.idles==1 && display.cleanCount==0 && acknowledgments==1);
+    assert(waits==std::vector<TickType_t>({portMAX_DELAY,400,portMAX_DELAY}));
+    a.delay=0;
+    run(m,{{true}});
+    assert(waits==std::vector<TickType_t>({portMAX_DELAY,portMAX_DELAY}));
+  }
+}
+'''.replace("@LOOP@", loop)
+
+with tempfile.TemporaryDirectory(prefix="paperdiy-idle-loop-") as directory:
+    work = Path(directory)
+    cpp = work / "check.cpp"
+    cpp.write_text(PROGRAM, encoding="utf-8")
+    for enabled in (1, 0):
+        binary = work / f"check-{enabled}"
+        subprocess.run(["c++", "-std=c++20", "-Wall", "-Wextra", "-Werror",
+                        f"-DFREEINK_DEVICE_PAPERDIY={enabled}", str(cpp), "-o", str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+print("Production render loop: quiet cleanup, held/input postponement, lock ownership, waiter safety and reader idle passed")
