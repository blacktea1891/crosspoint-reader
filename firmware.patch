+    lgfx::updates.clear();
+    d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal);
+    localOnly();
+    for(const auto u:lgfx::updates) assert(!touches(u.rect,304,600));  // cover unchanged
+  }
+  // In this layout the idle clean covers the visited rows only, not the cover
+  // between them, and still the first row after a round trip back to it.
+  lgfx::updates.clear(); d.runMaintenance(bus); assert(!d.hasPendingMaintenance());
+  assert(!lgfx::updates.empty()); queuedWithoutWait();
+  for(const auto u:lgfx::updates) { assert(u.mode==lgfx::epd_mode::epd_text); assert(!touches(u.rect,304,600)); }
