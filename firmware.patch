+#if FREEINK_DEVICE_PAPERDIY
+namespace {
+void drawPaperDiyHintCell(const GfxRenderer& renderer, const int fontId, const Rect cell, const StrId format,
+                          const char* action) {
+  if (!action || !*action || cell.width <= 0 || cell.height <= 0) return;
+  // Leave room for an ellipsis. Keep formatting and width fitting on the stack,
+  // including long translated labels and dynamic book/tab names.
+  char text[160];
+  const int formatted = snprintf(text, sizeof(text) - 3, I18N.get(format), action);
+  int length = utf8SafeTruncateBuffer(text, static_cast<int>(strlen(text)));
+  text[length] = '\0';
+  if (formatted >= static_cast<int>(sizeof(text) - 3) || renderer.getTextWidth(fontId, text) > cell.width) {
+    constexpr char ellipsis[] = "\xe2\x80\xa6";
+    const int ellipsisWidth = renderer.getTextWidth(fontId, ellipsis);
+    if (ellipsisWidth > cell.width) return;
+    while (length > 0 && renderer.getTextWidth(fontId, text) + ellipsisWidth > cell.width) {
+      --length;
+      while (length > 0 && (static_cast<uint8_t>(text[length]) & 0xC0) == 0x80) --length;
+      text[length] = '\0';
+    }
+    memcpy(text + length, ellipsis, sizeof(ellipsis));
+  }
+  const GfxRenderer::ClipScope clip(renderer, cell.x, cell.y, cell.width, cell.height);
+  const int y = cell.y + std::max(0, (cell.height - renderer.getLineHeight(fontId)) / 2);
+  renderer.drawText(fontId, cell.x, y, text);
+}
+}  // namespace
+
+void BaseTheme::drawPaperDiyButtonHints(GfxRenderer& renderer, const char* btn1, const char* btn2, const char* btn3,
+                                        const char* btn4) const {
+  if (!buttonHintsVisible()) return;
+  // Text instructions follow the page, rather than a fixed physical key edge.
+  const Rect area = UITheme::getContentArea(renderer);
+  const int width = area.width;
+  const auto& metrics = UITheme::getInstance().getMetrics();
+  const int height = std::min(metrics.buttonHintsHeight, area.height);
+  const int top = area.y + area.height - height;
+  const bool grayscale = renderer.getRenderMode() != GfxRenderer::BW && !renderer.grayPlanesAreAbsolute();
+  {
+    const GfxRenderer::ClipScope clip(renderer, area.x, top, width, height);
+    renderer.fillRect(area.x, top, width, height, grayscale);
+    if (!grayscale) {
+      const char* labels[] = {btn1, btn2, btn3, btn4};
+      const auto labelForRole = [&](const uint8_t hardware) { return hardware < 4 ? labels[hardware] : ""; };
+      const int padding = std::min(metrics.contentSidePadding, width / 8);
+      constexpr int columnGap = 12;
+      constexpr int rowGap = 4;
+      const int cellWidth = std::max(0, (width - 2 * padding - columnGap) / 2);
+      const int cellHeight = std::max(0, (height - rowGap - 8) / 2);
+      const int y = top + 4;
+      const int left = area.x + padding;
+      const int font = uiScaleSpec().smallFontId;
+      const auto textWidth = [&](const StrId format, const char* action) {
+        if (!action || !*action) return 0;
+        char text[160];
+        snprintf(text, sizeof(text) - 3, I18N.get(format), action);
+        text[utf8SafeTruncateBuffer(text, static_cast<int>(strlen(text)))] = '\0';
+        return renderer.getTextWidth(font, text);
+      };
+      const int rightNeeded =
+          std::max(textWidth(StrId::STR_PAPERDIY_TAP_B, labelForRole(SETTINGS.frontButtonRight)),
+                   textWidth(StrId::STR_PAPERDIY_HOLD_B, labelForRole(SETTINGS.frontButtonConfirm)));
+      int shift = 0;
+      if (rightNeeded > cellWidth) {
+        const int leftNeeded = std::max(textWidth(StrId::STR_PAPERDIY_TAP_A, labelForRole(SETTINGS.frontButtonLeft)),
+                                        textWidth(StrId::STR_PAPERDIY_HOLD_A, labelForRole(SETTINGS.frontButtonBack)));
+        // Borrow unused A-column space, keeping both rows aligned and A intact.
+        shift = std::min(rightNeeded - cellWidth, std::max(0, cellWidth - leftNeeded));
+      }
+      const int leftWidth = cellWidth - shift;
+      const int rightWidth = cellWidth + shift;
+      const int right = left + leftWidth + columnGap;
+      drawPaperDiyHintCell(renderer, font, Rect{left, y, leftWidth, cellHeight}, StrId::STR_PAPERDIY_TAP_A,
+                           labelForRole(SETTINGS.frontButtonLeft));
+      drawPaperDiyHintCell(renderer, font, Rect{right, y, rightWidth, cellHeight}, StrId::STR_PAPERDIY_TAP_B,
+                           labelForRole(SETTINGS.frontButtonRight));
+      drawPaperDiyHintCell(renderer, font, Rect{left, y + cellHeight + rowGap, leftWidth, cellHeight},
+                           StrId::STR_PAPERDIY_HOLD_A, labelForRole(SETTINGS.frontButtonBack));
+      drawPaperDiyHintCell(renderer, font, Rect{right, y + cellHeight + rowGap, rightWidth, cellHeight},
+                           StrId::STR_PAPERDIY_HOLD_B, labelForRole(SETTINGS.frontButtonConfirm));
+    }
+  }
+}
+#endif
+
 void BaseTheme::drawButtonHints(GfxRenderer& renderer, const char* btn1, const char* btn2, const char* btn3,
