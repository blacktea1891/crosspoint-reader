+  d.runMaintenance(bus);
+  assert(lgfx::updates.size()==1 && d.hasPendingMaintenance());
+  lgfx::updates.clear(); d.runMaintenance(bus);
+  assert(!d.hasPendingMaintenance()); equalFrame();
+  // A distant status icon must not expand a selection change into a full-screen
+  // bounding rectangle. Both changed islands are covered.
+  paint(old,0,40,H,true); paint(450,0,40,H,false); paint(900,0,8,8,false);
+  lgfx::updates.clear(); d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal);
+  localOnly();
+  // Landscape orientations turn the same selection into horizontal strips.
+  frame.fill(255); d.display(bus,frame.data(),nullptr,RefreshMode::Full,false);
+  int oldY=0;
+  for(int i=0;i<24;++i) {
+    paint(0,oldY,W,20,true); oldY=(i%6)*80; paint(0,oldY,W,20,false);
+    lgfx::updates.clear();
+    d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal);
+    localOnly();
+  }
+  // Native extremes exercise clipping and the final short 32-row band.
+  for(auto xy: {std::pair<int,int>{0,0},{W-1,0},{0,H-1},{W-1,H-1}}) {
+    paint(xy.first,xy.second,1,1,false); lgfx::updates.clear();
+    d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal);
+    if(!lgfx::updates.empty()) localOnly();
+  }
+  // Pending work is discarded on a reading transition before it can touch
+  // the page, and explicit full cleaning consumes the backlog immediately.
+  assert(d.hasPendingMaintenance());
+  d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::ContinuousReading);
+  assert(!d.hasPendingMaintenance()); lgfx::updates.clear(); d.runMaintenance(bus); assert(lgfx::updates.empty());
+  paint(100,100,8,8,false);
+  d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal);
+  assert(d.hasPendingMaintenance());
+  // Whole content replacement cleans once; identical repeats do not blink.
+  frame.fill(0); lgfx::updates.clear();
+  d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal); fullClean(); assert(!d.hasPendingMaintenance());
+  lgfx::updates.clear(); d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,true,RefreshContext::Normal);
+  assert(lgfx::updates.empty() && lgfx::sleeps>0);
+  // Reading and manual modes retain full-frame requests, even for tiny changes.
+  for(auto context: {RefreshContext::ContinuousReading,RefreshContext::TextOnlyAntiAliasing,RefreshContext::ImageReading}) {
+    lgfx::updates.clear(); d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,context);
