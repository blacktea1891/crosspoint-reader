+    // Two distant bars, one removed and one added: 7.4% of the panel. The
+    // planner keeps them as two exact islands instead of one half-screen box.
+    std::array<uint8_t,W*H/8> next; next.fill(255);
+    std::vector<uint8_t> previous(W*H,255);
