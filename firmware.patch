+nav_source = Path(os.environ["KEYBOARD_NAV_SOURCE"]).read_text() if os.environ.get("KEYBOARD_NAV_SOURCE") else source
+
+
+def method(name):
+    match = re.search(r"^[^\n]*KeyboardEntryActivity::" + name + r"\(.*?\n}", nav_source, re.M | re.S)
+    return match.group() if match else ""
+
+
+def between(start, end):
+    return source[source.index(start):source.index(end)]
+
+
+methods = [m for m in (method(n) for n in ("selectedKey", "clampSelection", "moveSelectionRow",
+                                           "moveSelectionCol", "moveSelectionAlongRow",
+                                           "moveSelectionDownColumn")) if m]
+declarations = "\n".join(m.split("{", 1)[0].replace("KeyboardEntryActivity::", "") + ";" for m in methods)
+vertical = between("  if (!cursorMode && mappedInput.wasPressed(MappedInputManager::Button::Up))",
