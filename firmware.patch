+"""Verify the restored complete LGFX driver; UI cadence is tested at the HAL."""
+from pathlib import Path
+import os
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+SDK = Path(os.environ.get("FREEINK_SDK_ROOT", ROOT / "freeink-sdk"))
+DISPLAY = SDK / "libs/display/FreeInkDisplay"
+
+ARDUINO = r'''
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#define HIGH 1
+#define LOW 0
+inline int digitalRead(int) { return HIGH; }
+inline void delay(unsigned) {}
+struct SerialStub { template<class... T> void printf(const char*, T...) {} };
+inline SerialStub Serial;
+'''
+
+M5GFX = r'''
+#pragma once
+#include <algorithm>
+#include <cassert>
+#include <cstdint>
+#include <vector>
+namespace lgfx {
+namespace epd_mode { enum epd_mode_t { epd_quality, epd_text, epd_fast, epd_fastest }; }
+namespace color_depth_t { enum type { grayscale_8bit }; }
+struct Rect { int x,y,w,h; };
+struct Record { Rect rect; epd_mode::epd_mode_t mode; };
+inline std::vector<Record> updates;
+inline std::vector<uint8_t> glass;
+inline bool missingCanvas = false;
+inline int sleeps = 0;
+// This boundary checks requests and ideal target pixels, not optical waveforms.
+struct Bus_EPD {
+  struct Config { int bus_speed=0, pin_data[8]{},pin_pwr=0,pin_sph=0,pin_spv=0,pin_oe=0,pin_le=0,pin_cl=0,pin_ckv=0,bus_width=0; };
+  Config value;
+  virtual ~Bus_EPD() = default;
+  virtual bool init() { return true; }
+  virtual bool powerControl(bool on) { _pwr_on=on; return true; }
+  Config config() { return value; }
+  void config(Config c) { value=c; }
+  void wait() {}
+protected:
+  bool _pwr_on=false;
+};
+struct Panel_EPD {
+  struct Detail {
+    int line_padding=0;
+    const uint32_t *lut_quality=nullptr,*lut_text=nullptr,*lut_fast=nullptr,*lut_fastest=nullptr;
+    size_t lut_quality_step=0,lut_text_step=0,lut_fast_step=0,lut_fastest_step=0;
+  } detail;
+  struct Config { int memory_width=0,panel_width=0,memory_height=0,panel_height=0,offset_rotation=0,offset_x=0,offset_y=0; bool bus_shared=false; } value;
+  void setBus(Bus_EPD*) {}
+  Detail config_detail() { return detail; }
+  void config_detail(Detail c) { detail=c; }
+  Config config() { return value; }
+  void config(Config c) { value=c; }
+};
+class LGFX_Device {
+public:
+  Panel_EPD* panel=nullptr;
+  epd_mode::epd_mode_t mode=epd_mode::epd_fast;
+  bool autoDisplay=true, clipped=false, pending=false;
+  Rect clip{},dirty{};
+  std::vector<uint8_t> buffer;
+  void setPanel(Panel_EPD* p) { panel=p; }
+  bool init() { buffer.assign(width()*height(),255); glass=buffer; return true; }
+  int width() const { return panel->value.panel_width; }
+  int height() const { return panel->value.panel_height; }
+  void setRotation(int r) { assert(r==0); }
+  void setEpdMode(epd_mode::epd_mode_t m) { mode=m; }
+  void waitDisplay() {}
+  void sleep() { ++sleeps; }
+  uint32_t color888(int r,int,int) { return r; }
+  void setAutoDisplay(bool v) { autoDisplay=v; }
+  void setClipRect(int x,int y,int w,int h) { clipped=true; clip={x,y,w,h}; }
+  void clearClipRect() { clipped=false; }
+  void mark(Rect r) {
+    if(!pending) { dirty=r; pending=true; }
+    else {
+      const int right=std::max(dirty.x+dirty.w,r.x+r.w),bottom=std::max(dirty.y+dirty.h,r.y+r.h);
+      dirty.x=std::min(dirty.x,r.x); dirty.y=std::min(dirty.y,r.y);
+      dirty.w=right-dirty.x; dirty.h=bottom-dirty.y;
+    }
+  }
+  void transfer(const uint8_t* source) {
+    const Rect r=clipped?clip:Rect{0,0,width(),height()};
+    assert(r.x>=0 && r.y>=0 && r.x+r.w<=width() && r.y+r.h<=height());
+    for(int y=r.y;y<r.y+r.h;++y) for(int x=r.x;x<r.x+r.w;++x) buffer[y*width()+x]=source[y*width()+x];
+    mark(r);
+    if(autoDisplay) display();
+  }
+  void fillScreen(uint32_t color) { std::fill(buffer.begin(),buffer.end(),color); mark({0,0,width(),height()}); }
+  void display(int x=0,int y=0,int w=0,int h=0) {
+    if(w>0 && h>0) mark({x,y,w,h});
+    if(!pending) return;
+    updates.push_back({dirty,mode});
+    for(int row=dirty.y;row<dirty.y+dirty.h;++row)
+      for(int col=dirty.x;col<dirty.x+dirty.w;++col) glass[row*width()+col]=buffer[row*width()+col];
+    pending=false;
+  }
+};
+class LGFX_Sprite {
+  LGFX_Device* device;
+  std::vector<uint8_t> bytes;
+public:
+  explicit LGFX_Sprite(LGFX_Device* d):device(d) {}
+  void setPsram(bool) {}
+  void setColorDepth(color_depth_t::type) {}
+  void createSprite(int w,int h) { bytes.resize(w*h); }
+  void* getBuffer() { return missingCanvas ? nullptr : bytes.data(); }
+  void pushSprite(int x,int y) { assert(x==0 && y==0); device->transfer(bytes.data()); }
+};
+}
+'''
+
+TEST = r'''
+#include <array>
+#include <cassert>
+#include <cstdio>
+#include "driver/LgfxEpdDriver.cpp"
+namespace freeink { EpdBus::~EpdBus() = default; }
+using namespace freeink;
+constexpr int W=960,H=540;
+std::array<uint8_t,W*H/8> frame;
+const LgfxEpdConfig& config() { static const LgfxEpdConfig c{}; return c; }
+namespace freeink { const LgfxEpdConfig& paperDiyLgfxConfig() { return config(); } }
+namespace freeink { const LgfxEpdConfig& m5PaperS3LgfxConfig() { return config(); } }
+void checkFrame(lgfx::epd_mode::epd_mode_t mode) {
+  assert(lgfx::updates.size()==1);
+  const auto u=lgfx::updates[0];
+  assert(u.rect.x==0 && u.rect.y==0 && u.rect.w==W && u.rect.h==H && u.mode==mode);
+  for(int y=0;y<H;++y) for(int x=0;x<W;++x)
+    assert(lgfx::glass[y*W+x]==((frame[y*(W/8)+x/8]&(0x80>>(x%8)))?255:0));
+}
+int main() {
+  EpdBus bus; LgfxEpdDriver d(config()); d.begin(bus); frame.fill(255);
+  // Cadence belongs to the shared HAL, never a second SDK counter/area heuristic.
+  for(int i=0;i<95;++i) {
+    frame.fill(255); frame[(i*701)%frame.size()]=0;
+    lgfx::updates.clear();
+    d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,RefreshContext::Normal);
+    checkFrame(lgfx::epd_mode::epd_fast);
+    assert(!d.hasPendingMaintenance());
+    const auto before=lgfx::updates.size(); d.runMaintenance(bus);
+    assert(lgfx::updates.size()==before);
+  }
+  for(auto mode:{RefreshMode::Half,RefreshMode::Full}) {
+    lgfx::updates.clear(); d.display(bus,frame.data(),nullptr,mode,false);
+    checkFrame(lgfx::epd_mode::epd_text);
+  }
+  for(auto context:{RefreshContext::ContinuousReading,RefreshContext::TextOnlyAntiAliasing,RefreshContext::ImageReading}) {
+    lgfx::updates.clear(); d.displayWithContext(bus,frame.data(),nullptr,RefreshMode::Fast,false,context);
+    checkFrame(lgfx::epd_mode::epd_fast);
+  }
+  // AA base and overlay use the same bank; no experimental UI maintenance.
+  frame.fill(255);
+  d.displayGrayscaleBaseWithContext(bus,frame.data(),RefreshMode::Fast,false,RefreshContext::TextOnlyAntiAliasing);
+  std::array<uint8_t,W*H/8> plane{}; plane[100]=128;
+  d.copyGrayscaleLsb(bus,plane.data()); d.copyGrayscaleMsb(bus,plane.data());
+  lgfx::updates.clear(); d.displayGray(bus,nullptr,false,nullptr,false);
+  assert(lgfx::updates.size()==1 && lgfx::updates[0].mode==lgfx::epd_mode::epd_fast && lgfx::glass[800]==0x55);
+  assert(!d.hasPendingMaintenance());
+  d.cleanupGrayscaleBuffers(bus,frame.data());
+  lgfx::updates.clear(); d.display(bus,frame.data(),nullptr,RefreshMode::Full,true);
+  checkFrame(lgfx::epd_mode::epd_text); assert(lgfx::sleeps>0);
+  d.deepSleep(bus); assert(!d.hasPendingMaintenance());
+  std::puts("production LGFX original full-frame modes, grayscale and no UI maintenance passed");
+}
+'''
+
+with tempfile.TemporaryDirectory(prefix="paperdiy-display-driver-") as directory:
+    work = Path(directory)
