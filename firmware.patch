+#define EPD_DRAW_SUCCESS 0
+#define EPD_DRAW_EMPTY_LINE_QUEUE 1
+#define portMAX_DELAY 0
+#define pdTRUE 1
+typedef struct {
+  int cycle_frames, current_frame, error;
+  int feed_tasks[2], feed_done_smphr[2], frame_done;
+  LineQueue_t line_queues[2];
+} RenderContext_t;
+static RenderContext_t* live;
+static int fail_phase, phases, takes, resets, notifications;
+static void* line_cb;
+static void* done_cb;
+typedef void (*frame_done_func_t)(RenderContext_t*);
+static void handle_lcd_frame_done(RenderContext_t* c) { (void)c; }
+static int xPortGetCoreID(void) { return 0; }
+static void epd_set_mode(int mode) { (void)mode; }
+static void epd_lcd_frame_done_cb(frame_done_func_t cb, void* p) { done_cb=(void*)cb; (void)p; }
+static void epd_lcd_line_source_cb(void* cb, void* p) { line_cb=cb; (void)p; }
+static void prepare_context_for_next_frame(RenderContext_t* c) {
+  (void)c; ++phases; takes=0; line_cb=(void*)1;
+}
+static void xTaskNotifyGive(int task) { (void)task; ++notifications; }
+static void xSemaphoreTake(int sem, int wait) {
+  (void)sem; (void)wait; ++takes;
+  if (takes==1 && phases==fail_phase) live->error=EPD_DRAW_EMPTY_LINE_QUEUE;
+  if (takes==3 && !live->error) {
+    // A completed DMA frame consumes every queued line.
+    uint8_t out[4];
+    for(int q=0;q<2;++q) while(lq_read(&live->line_queues[q],out)==0) {}
+  }
+}
+static void vTaskDelay(int n) { (void)n; }
+static void paperdiy_prepare_feed(RenderContext_t* c) { (void)c; }
+void real_lq_reset(LineQueue_t*);
+void lq_reset(LineQueue_t* q) {
+  // Queue reset while either producer/ISR is active is invalid.
+  assert(takes==3); ++resets; real_lq_reset(q);
+}
+@FUNCTION@
+int main(void) {
+  RenderContext_t c={0}; live=&c;
+  uint8_t rows[2][4][4]; uint8_t* ptrs[2][4];
+  for(int q=0;q<2;++q) {
+    for(int r=0;r<4;++r) ptrs[q][r]=rows[q][r];
+    c.line_queues[q].size=4; c.line_queues[q].element_size=4; c.line_queues[q].bufs=ptrs[q];
+  }
+  for(int fault=1;fault<=3;++fault) {
+    phases=notifications=resets=0; fail_phase=fault;
+    c.current_frame=0; c.cycle_frames=3; c.error=0;
+    // One feeder can finish before the other observes the error. Both queues
+    // contain stale data, as can happen on an underrun/callback scheduling race.
+    for(int q=0;q<2;++q) {
+      memset(lq_current(&c.line_queues[q]),0xA0+q,4); lq_commit(&c.line_queues[q]);
+    }
+    lcd_do_update(&c);
+    assert(c.error && phases==fault && c.current_frame==fault-1);
+    assert(notifications==fault*2 && resets==2 && !line_cb && !done_cb);
+    uint8_t out[4];
+    for(int q=0;q<2;++q) assert(lq_read(&c.line_queues[q],out)==-1);
+    // Next request starts with fresh rows, never a previous attempt's data.
+    c.error=0; c.current_frame=0; c.cycle_frames=3;
+    phases=notifications=resets=0; fail_phase=0;
+    for(int q=0;q<2;++q) {
+      memset(lq_current(&c.line_queues[q]),0x55+q,4); lq_commit(&c.line_queues[q]);
+      assert(lq_read(&c.line_queues[q],out)==0 && out[0]==0x55+q);
+    }
+    lcd_do_update(&c);
+    assert(!c.error && phases==3 && c.current_frame==3 && notifications==6 && resets==0);
+  }
+}
+'''
