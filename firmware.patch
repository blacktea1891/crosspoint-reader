+      previous[y*W+128+dx]=0; const int x=704+dx; next[y*(W/8)+x/8]&=static_cast<uint8_t>(~(0x80>>(x%8)));
+    }
+    const auto r=detail::LgfxUiRegions::find(next.data(),previous.data(),W,H);
+    assert(!r.large && r.count==2);
+    assert(r.rects[0].x==128 && r.rects[0].w==40 && r.rects[0].y==32 && r.rects[0].h==480);
+    assert(r.rects[1].x==704 && r.rects[1].w==40 && r.rects[1].y==32 && r.rects[1].h==480);
+  }
+  {
+    // Bounded degradation, recorded exactly. A join may cover a small unchanged
+    // gap: 64x32 islands 16 px apart become one 144x32 rectangle (+12.5%).
+    detail::LgfxUiDirtyRects dirty; detail::LgfxUiRegions r; r.count=2;
+    r.rects[0]={0,0,64,32}; r.rects[1]={80,0,64,32}; dirty.add(r);
+    assert(dirty.size()==1);
+    const auto j=dirty.data()[0]; assert(j.x==0 && j.y==0 && j.w==144 && j.h==32);
+    assert(covers(dirty.data(),dirty.size(),72,16));  // unchanged gap is cleaned
+    // A ninth distant island with all eight slots used folds into the rectangle
+    // that grows least, without the join limit: unchanged x=792..895 is covered.
+    dirty.clear(); r.count=1;
+    for(int i=0;i<9;++i) { r.rects[0]={static_cast<uint16_t>(i*112),0,8,32}; dirty.add(r); }
+    assert(dirty.size()==8); inPanel(dirty.data(),dirty.size());
+    for(int i=0;i<9;++i) assert(covers(dirty.data(),dirty.size(),i*112,0) && covers(dirty.data(),dirty.size(),i*112+7,31));
+    int folded=0;
+    for(int i=0;i<8;++i) { const auto f=dirty.data()[i]; if(f.w!=8) { ++folded; assert(f.x==784 && f.y==0 && f.w==120 && f.h==32); } }
+    assert(folded==1 && covers(dirty.data(),dirty.size(),850,16));
+    // The planner degrades the same way for nine islands in one band.
+    std::array<uint8_t,W*H/8> next; next.fill(255);
+    std::vector<uint8_t> previous(W*H,255);
+    for(int i=0;i<9;++i) for(int y=0;y<32;++y) for(int dx=0;dx<8;++dx) previous[y*W+i*112+dx]=0;
+    const auto p=detail::LgfxUiRegions::find(next.data(),previous.data(),W,H);
