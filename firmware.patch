+++ b/test/test_paperdiy_refresh_budget.py
@@ -0,0 +1,122 @@
+"""Compile the complete production HAL against a recording SDK boundary."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+
+SDK = r'''
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+namespace freeink {
+enum class GrayscaleMode { Overlay };
+enum class GrayscaleBase { Separate, Combined };
+enum class GrayscaleEncoding { OverlayMasks };
+struct GrayscaleCapabilities { bool asyncBase=false, stripUploads=true; GrayscaleBase base=GrayscaleBase::Separate; };
+}
+struct EInkDisplay {
+  enum RefreshMode { FULL_REFRESH, HALF_REFRESH, FAST_REFRESH };
+  enum class RefreshContext { Normal, ContinuousReading, TextOnlyAntiAliasing, ImageReading };
+  enum { GRAY_PLANE_LSB, GRAY_PLANE_MSB };
+  static constexpr uint16_t DISPLAY_WIDTH=960, DISPLAY_HEIGHT=540;
+  struct Record { RefreshMode mode; bool off; RefreshContext context; bool async; };
+  inline static std::vector<Record> records;
+  inline static bool committed=true;
+  template<class... T> EInkDisplay(T...) {}
+  void displayBuffer(RefreshMode mode, bool off, RefreshContext context) { records.push_back({mode,off,context,false}); }
+  void displayBufferAsyncNoShadow(RefreshMode mode, RefreshContext context) { records.push_back({mode,false,context,true}); }
+  void refreshDisplay(RefreshMode mode, bool off) { displayBuffer(mode,off,RefreshContext::Normal); }
+  bool displayCommitted() const { return committed; }
+  freeink::GrayscaleCapabilities grayscaleCapabilities(freeink::GrayscaleMode) const { return {}; }
+  template<class... T> bool displayGrayscaleBase(T...) { return true; }
+#define VOID_METHOD(name) template<class... T> void name(T...) const {}
+  VOID_METHOD(abortPostRefresh) VOID_METHOD(begin) VOID_METHOD(cancelGrayscale16)
+  VOID_METHOD(cleanupGrayscaleBuffers) VOID_METHOD(clearScreen) VOID_METHOD(copyGrayscaleBuffers)
+  VOID_METHOD(copyGrayscaleLsbBuffers) VOID_METHOD(copyGrayscaleMsbBuffers) VOID_METHOD(deepSleep)
+  VOID_METHOD(displayGrayBuffer) VOID_METHOD(drawImage) VOID_METHOD(drawImageTransparent)
+  VOID_METHOD(preconditionGrayscale) VOID_METHOD(requestResync) VOID_METHOD(returnBuildStorage)
+  VOID_METHOD(setDisplayX3) VOID_METHOD(setInverted) VOID_METHOD(setMurphyM4Batch)
+  VOID_METHOD(skipInitialResync) VOID_METHOD(waitRefreshComplete) VOID_METHOD(writeGrayscalePlaneStrip)
+#undef VOID_METHOD
+#define BOOL_METHOD(name) bool name() const { return false; }
+  BOOL_METHOD(canUseTextTransition) BOOL_METHOD(commitGrayscale16) BOOL_METHOD(isInverted)
+  BOOL_METHOD(supportsAsyncRefresh) BOOL_METHOD(supportsContinuousImageReading)
+  BOOL_METHOD(supportsReaderTransitions) BOOL_METHOD(supportsTextOnlyCombinedBase) BOOL_METHOD(toggleInverted)
+#undef BOOL_METHOD
+  uint8_t* beginGrayscale16() const { return nullptr; }
+  uint8_t* getFrameBuffer() const { return nullptr; }
+  uint8_t* lendBuildStorage(uint32_t*) { return nullptr; }
+  uint16_t getDisplayWidth() const { return 960; }
+  uint16_t getDisplayHeight() const { return 540; }
+  uint16_t getDisplayWidthBytes() const { return 120; }
+  uint32_t getBufferSize() const { return 64800; }
+  uint8_t getGrayscaleLevels() const { return 4; }
+};
+'''
+
+TEST = r'''
+#include <cassert>
+#include "HalDisplay.h"
+#include "PaperDiyRefreshBudget.h"
+int main() {
+  static_assert(sizeof(PaperDiyRefreshBudget)==1);
+  const auto fast=HalDisplay::FAST_REFRESH;
+  const auto half=HalDisplay::HALF_REFRESH;
+  const auto full=HalDisplay::FULL_REFRESH;
+  auto check=[](auto mode) { assert(EInkDisplay::records.back().mode==static_cast<EInkDisplay::RefreshMode>(mode)); };
+  display.displayBuffer(full); check(full);
+  for (int i=0;i<16;++i) {
+    if (i%3==0) display.displayBufferAsync(fast);
+    else if (i%3==1) display.refreshDisplay(fast,true);
+    else display.displayBuffer(fast);
+    check(FREEINK_DEVICE_PAPERDIY && i%4==3 ? half : fast);
+  }
+  display.displayBuffer(full); check(full);
+  for(int i=0;i<3;++i) { display.displayBuffer(fast); check(fast); }
+  for(auto context : {DisplayRefreshContext::ContinuousReading,DisplayRefreshContext::TextOnlyAntiAliasing,
+                     DisplayRefreshContext::ImageReading}) {
+    for(int i=0;i<20;++i) { display.displayBufferAsync(fast,context); check(fast); }
+  }
+  display.displayBuffer(fast); check(FREEINK_DEVICE_PAPERDIY ? half : fast);
+  // Existing explicit cleaning requests keep their strength and reset the UI budget.
+  display.displayBuffer(full); check(full);
+  for(int i=0;i<3;++i) { display.displayBuffer(fast); check(fast); }
+  display.displayBuffer(half,true); check(half);
+  assert(EInkDisplay::records.back().off);
+  for(int i=0;i<3;++i) { display.displayBuffer(fast); check(fast); }
+  // A failed commit must not consume the due cleanup or reset its budget.
+  EInkDisplay::committed=false;
+  display.displayBuffer(fast); check(FREEINK_DEVICE_PAPERDIY ? half : fast);
+  EInkDisplay::committed=true;
+  display.displayBuffer(fast); check(FREEINK_DEVICE_PAPERDIY ? half : fast);
+  display.displayBuffer(fast); check(fast);
+}
+'''
+
+with tempfile.TemporaryDirectory(prefix='paperdiy-ui-refresh-') as directory:
+    folder = Path(directory)
+    (folder / 'Arduino.h').write_text('#pragma once\n#include <cstdint>\n')
+    (folder / 'BoardConfig.h').write_text('''#pragma once
+namespace BoardConfig { enum class DisplayController { Test }; inline constexpr struct {
+DisplayController displayController=DisplayController::Test;
+} ACTIVE; }
+''')
+    (folder / 'HalGPIO.h').write_text('''#pragma once
+inline constexpr int EPD_SCLK=0, EPD_MOSI=0, EPD_CS=0, EPD_DC=0, EPD_RST=0, EPD_BUSY=0;
+struct HalGPIO { enum class WakeupReason { PowerButton, AfterFlash, Other };
+bool deviceIsX3() const { return false; } WakeupReason getWakeupReason() const { return WakeupReason::Other; }
+}; inline HalGPIO gpio;
+''')
+    (folder / 'EInkDisplay.h').write_text(SDK)
+    source = folder / 'check.cpp'
+    source.write_text(TEST)
+    for enabled in (0, 1):
+        executable = folder / f'check-{enabled}'
+        subprocess.run(['c++', '-std=c++20', '-Wall', '-Wextra', '-Werror',
+                        '-I' + str(folder), '-I' + str(ROOT / 'lib/hal'),
+                        f'-DFREEINK_DEVICE_PAPERDIY={enabled}',
+                        str(source), str(ROOT / 'lib/hal/HalDisplay.cpp'), '-o', str(executable)], check=True)
+        subprocess.run([str(executable)], check=True)
+print('PaperDIY shared UI cadence, sync/async/refresh entrypoints, reader contexts, failed commits and non-DIY baseline passed')
