+                        ? base
+                        : base + ButtonNavigator::nextIndex(selectorIndex - base, count);
+  } else if (horizontal) {
+    if (coversFocused && bookCount > 1) {
+      selectorIndex = ButtonNavigator::nextIndex(selectorIndex, bookCount);
+      lastCarouselBookIndex = selectorIndex;
+    } else if (coversFocused || bookCount == 0) {
+      selectorIndex = ButtonNavigator::previousIndex(selectorIndex, bookCount + menuCount);
+    } else if (selectorIndex == bookCount) {
+      selectorIndex = std::clamp(lastCarouselBookIndex, 0, bookCount - 1);
+    } else {
+      --selectorIndex;
+    }
+  } else if (coversFocused) {
+    lastCarouselBookIndex = selectorIndex;
+    selectorIndex = bookCount;
+  } else {
+    ++selectorIndex;
+    if (selectorIndex >= bookCount + menuCount) {
+      selectorIndex = bookCount > 0 ? std::clamp(lastCarouselBookIndex, 0, bookCount - 1) : 0;
+    }
+  }
+  requestUpdate();
+  return true;
+}
