@@ -226,6 +226,28 @@ void KeyboardEntryActivity::moveSelectionCol(const int delta) {
   selCol = (selCol + delta + cols) % cols;
 }
 
+void KeyboardEntryActivity::moveSelectionAlongRow() {
+  const fui::KeyboardLayout& layout = currentLayout();
+  if (layout.rowCount == 0) return;
+  clampSelection();
+  const int cols = layout.rows[selRow].count;
+  if (cols > 0) selCol = (selCol + 1) % cols;
+}
+
+void KeyboardEntryActivity::moveSelectionDownColumn() {
+  const fui::KeyboardLayout& layout = currentLayout();
+  if (layout.rowCount == 0) return;
+  clampSelection();
+  // Skip rows too short for this column; stay put if no other row has it.
+  for (int step = 1; step < layout.rowCount; step++) {
+    const int row = (selRow + step) % layout.rowCount;
+    if (selCol < layout.rows[row].count) {
+      selRow = row;
+      return;
+    }
+  }
+}
+
 bool KeyboardEntryActivity::syncSelectionToValue(const int16_t value) {
