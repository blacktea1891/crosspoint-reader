+'''
+
+TEST = r'''
+#include <cassert>
+#include "HalDisplay.h"
+int main() {
+  const auto fast=HalDisplay::FAST_REFRESH, half=HalDisplay::HALF_REFRESH, full=HalDisplay::FULL_REFRESH;
+  auto check=[](auto mode) { assert(EInkDisplay::records.back().mode==static_cast<EInkDisplay::RefreshMode>(mode)); };
+  display.displayBuffer(full); check(full);
+  // One shared cadence across Home/Settings-style sync, async and refresh calls.
+  for(int i=1;i<=90;++i) {
+    const auto before=EInkDisplay::records.size();
+    if(i%3==0) display.displayBufferAsync(fast);
+    else if(i%3==1) display.refreshDisplay(fast,true);
+    else display.displayBuffer(fast);
+    assert(EInkDisplay::records.size()==before+1);
+#if FREEINK_DEVICE_PAPERDIY
+    check(i%30==0 ? half : fast);
+    assert(!EInkDisplay::records.back().async);
+#else
+    check(fast);
+#endif
+  }
+#if FREEINK_DEVICE_PAPERDIY
+  // A failed 30th clean cannot consume/reset the pending cadence.
+  display.displayBuffer(full);
+  for(int i=0;i<29;++i) { display.displayBuffer(fast); check(fast); }
+  EInkDisplay::committed=false; display.displayBuffer(fast); check(half);
+  EInkDisplay::committed=true; display.displayBuffer(fast); check(half);
+  display.displayBuffer(fast); check(fast);
+#endif
+  // Reading and AA/image contexts never get periodic UI promotions.
+  display.displayBuffer(full);
+  for(auto context : {DisplayRefreshContext::ContinuousReading,DisplayRefreshContext::TextOnlyAntiAliasing,
+                     DisplayRefreshContext::ImageReading}) {
+    for(int i=0;i<60;++i) { display.displayBufferAsync(fast,context); check(fast); }
+  }
+  for(int i=1;i<=30;++i) {
+    display.displayBuffer(fast);
+#if FREEINK_DEVICE_PAPERDIY
+    check(i==30 ? half : fast);
+#else
+    check(fast);
+#endif
+  }
+  // Manual/transition Half and Full retain their strength and restart the UI budget.
+  for(auto explicitMode : {half,full}) {
+    display.displayBuffer(explicitMode,true); check(explicitMode);
+    assert(EInkDisplay::records.back().off);
+    for(int i=1;i<=29;++i) { display.displayBuffer(fast); check(fast); }
+    display.displayBuffer(explicitMode); check(explicitMode);
+    display.displayBuffer(fast); check(fast);
+  }
+#if FREEINK_DEVICE_PAPERDIY
+  auto recover=[] {
+    const auto before=EInkDisplay::records.size();
+    const auto resyncs=EInkDisplay::resyncs;
+    display.requestDisplayRecovery();
+    assert(EInkDisplay::records.size()==before && EInkDisplay::resyncs==resyncs+1);
+  };
+  recover();
+  EInkDisplay::committed=false;
+  display.displayBuffer(fast); check(half);
+  display.displayBufferAsync(fast); check(half);
+  EInkDisplay::committed=true;
+  display.displayBuffer(fast); check(half);
+  for(int i=1;i<=30;++i) { display.displayBuffer(fast); check(i==30 ? half : fast); }
+  // Staging and a failed native submission must not consume recovery.
+  recover();
+  EInkDisplay::committed=false;
+  display.displayGrayscaleBase(fast,false,DisplayRefreshContext::TextOnlyAntiAliasing);
+  assert(EInkDisplay::grayMode==EInkDisplay::HALF_REFRESH);
+  assert(!display.commitGrayscale16(fast) && EInkDisplay::nativeMode==EInkDisplay::HALF_REFRESH);
+  display.cancelGrayscale16();
+  EInkDisplay::committed=true;
+  assert(display.commitGrayscale16() && EInkDisplay::nativeMode==EInkDisplay::HALF_REFRESH);
+  assert(display.commitGrayscale16(fast) && EInkDisplay::nativeMode==EInkDisplay::FAST_REFRESH);
+  recover();
+  EInkDisplay::committed=false;
+  assert(display.displayGrayscaleBase(HalDisplay::GrayscaleMode::Overlay,fast,false));
+  assert(EInkDisplay::grayMode==EInkDisplay::HALF_REFRESH);
+  display.displayGrayBuffer();
+  display.displayGrayscaleBase(fast,false,DisplayRefreshContext::TextOnlyAntiAliasing);
+  assert(EInkDisplay::grayMode==EInkDisplay::HALF_REFRESH);
+  EInkDisplay::committed=true;
+  display.displayGrayBuffer();
+  display.displayBuffer(fast); check(fast);
+#endif
+}
+'''
